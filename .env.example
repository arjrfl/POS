# Copy this file to .env in the project root and fill in real values.
# docker-compose.yml reads these to configure the postgres, backend, and
# backup containers. Never commit the real .env file.

# Password for the "pos" PostgreSQL role. Used by the postgres container
# (POSTGRES_PASSWORD), the backend's DATABASE_URL, and the backup container.
DB_PASSWORD=changeme

# Secret key used to sign JWT access tokens issued by the backend.
# Generate a long random value for real deployments, e.g.: openssl rand -hex 32
SECRET_KEY=changeme

# How long an issued JWT access token stays valid, in minutes.
# The backend silently refreshes this on every authenticated request via the
# X-Refreshed-Token response header, so active terminals stay logged in
# indefinitely — only a truly idle terminal expires after this many minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Runtime mode for the backend: "development" or "production".
ENVIRONMENT=production
